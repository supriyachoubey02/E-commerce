<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> - My E-commerce Store</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>My Store</h1>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/cart">Cart (<%= session.cart ? session.cart.reduce((sum, item) => sum + item.quantity, 0) : 0 %>)</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <section class="product-detail">
            <h2><%= product.name %></h2>
            <img src="<%= product.image %>" alt="<%= product.name %>">
            <p><%= product.description %></p>
            <p>Price: $<%= product.price.toFixed(2) %></p>
            <form action="/cart/add/<%= product._id %>" method="post">
                <label for="quantity">Quantity:</label>
                <input type="number" id="quantity" name="quantity" value="1" min="1">
                <button type="submit">Add to Cart</button>
            </form>
            <a href="/">Back to Products</a>
        </section>
    </main>

    <footer>
        <p>&copy; 2025 My E-commerce Store</p>
    </footer>
</body>
</html>